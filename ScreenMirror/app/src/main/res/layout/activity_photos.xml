<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="#0B65ED">

    <!-- Top Header Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_blue_header"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="45dp"
            android:background="@drawable/bg_back_button_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_gravity="center"
                android:id="@+id/photosBack"
                android:src="@drawable/ic_back_white"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Photos"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main White Sheet -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/whiteSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_white_sheet_rounded"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintVertical_bias="0.142"
        tools:layout_editor_absoluteX="-50dp">

        <!-- Segmented Tab Bar -->
        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_segmented_toggle_track"
            android:orientation="horizontal"
            android:padding="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tabAllPhotos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_toggle_active"
                android:gravity="center"
                android:text="All Photos"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabAlbumPhotos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="Album Photos"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:textStyle="normal" />

        </LinearLayout>
        <!-- Media Grid (All Photos) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40sdp"
            android:clipToPadding="false"
            android:padding="@dimen/_6sdp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabContainer">

            <GridLayout
                android:layout_width="@dimen/_290sdp"
                android:layout_height="@dimen/_450sdp"
                android:columnCount="3">

                <!-- Row 1 -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img_1"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img2"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img3"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />

                <!-- Row 2 -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img4"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img5"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img6"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />

                <!-- Row 3 -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img7"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img8"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="20dp"
                    android:layout_height="220dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:src="@drawable/img9"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />
            </GridLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Media Grid (Album Photos) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollAlbums"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_60sdp"
            android:clipToPadding="false"
            android:padding="@dimen/_6sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabContainer">

            <GridLayout
                android:layout_width="@dimen/_290sdp"
                android:layout_height="@dimen/_450sdp"

                android:columnCount="3">

                <!-- Album Item 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:orientation="vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_1"
                        app:shapeAppearanceOverlay="@style/RoundedCorner12dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="DCIM (100)"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Album Item 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:orientation="vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img2"
                        app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Photos (68)"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Album Item 3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:orientation="vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img3"
                        app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mine (23)"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:orientation="vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img4"
                        app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="DCIM (100)"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:orientation="vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img5"
                        app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Photos (68)"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="2dp"
                    android:orientation="vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img6"
                        app:shapeAppearanceOverlay="@style/RoundedCorner12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mine (23)"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>


            </GridLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>